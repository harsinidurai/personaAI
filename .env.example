# PersonaAI Environment Configuration
# This file shows all environment variables used in the project
# Copy values to backend/.env and frontend/.env

# ==========================================
# BACKEND CONFIGURATION (.env files)
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String
# Using MongoDB Atlas (cloud)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://jershagracelin:jersha12345@cluster0.osu23dz.mongodb.net/?appName=Cluster0

# JWT Secret for token signing
# Use a strong, random string in production
JWT_SECRET=personaai_super_secret_key_54321

# ==========================================
# TUYA AI INTEGRATION
# ==========================================

# Tuya IoT Platform Credentials
# Get these from: https://iot.tuya.com
TUYA_ACCESS_ID=taqgtanpysymavkthxfh
TUYA_ACCESS_SECRET=6a2bc203f4d94a128e712915c29b4a84
TUYA_AGENT_ID=aipt_fd8ira2nsjcw

# Tuya API Base URL
# Use .com for US, .cn for China
TUYA_BASE_URL=https://openapi.tuyaus.com

# ==========================================
# FRONTEND CONFIGURATION (.env files)
# ==========================================

# Backend API URL
# Local development
VITE_API_URL=http://localhost:5000/api

# Production (change this when deploying)
# VITE_API_URL=https://your-backend-domain.com/api

# ==========================================
# OPTIONAL: Advanced Configuration
# ==========================================

# Node Environment
NODE_ENV=development

# Logging Level
LOG_LEVEL=debug

# CORS Origin (for production)
# CORS_ORIGIN=https://your-frontend-domain.com

# Database Name (if not using MongoDB Atlas)
# DB_NAME=personaai

# ==========================================
# NOTES
# ==========================================

# 1. Backend variables go in: backend/.env
# 2. Frontend variables go in: frontend/.env
# 3. Keep sensitive values secret - never commit to git
# 4. Use strong JWT secret in production
# 5. MongoDB URI has credentials - keep it private
# 6. Generate new JWT secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 7. All variables are currently pre-configured and working

# ==========================================
# HOW TO GET TUYA CREDENTIALS
# ==========================================

# 1. Create account at https://iot.tuya.com
# 2. Go to Cloud → Project
# 3. Create new Cloud Project
# 4. Go to Service → AI Agent
# 5. Create new AI Agent
# 6. Get:
#    - Access ID: visible in project settings
#    - Access Secret: visible in project settings
#    - Agent ID: generated when you create the agent
# 7. Set region-appropriate URL (.com for US, .cn for China)
