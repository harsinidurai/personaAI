{
  "name": "personaai",
  "version": "1.0.0",
  "description": "3D AI Chat Application with Multiple Personas powered by Tuya AI",
  "private": true,
  "scripts": {
    "setup": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ..",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "start": "npm run dev",
    "dev": "node dev-server.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend-only": "cd backend && npm run dev",
    "dev:frontend-only": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "build-all": "cd backend && npm install && cd ../frontend && npm install && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "ai",
    "chat",
    "persona",
    "3d",
    "avatar",
    "tuya",
    "react",
    "express",
    "mongodb"
  ],
  "author": "You",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@vitejs/plugin-react": "^5.1.4",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "3.7",
    "mongoose": "^9.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "vite": "^7.3.1",
    "zustand": "^5.0.11"
  }
}
